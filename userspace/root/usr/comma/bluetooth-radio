#!/bin/bash -e

FIRMWARE_MOUNT=/run/starpilot-bluetooth-firmware
FIRMWARE_BIND=/lib/firmware/qca
BLUETOOTH_STATE=/data/bluetooth
BLUETOOTH_BIND=/var/lib/bluetooth
STATE_DIR=/run/starpilot-bluetooth-radio

power() {
  /usr/bin/python3 - "$1" <<'PY'
import fcntl
import os
import sys

fd = os.open("/dev/btpower", os.O_RDWR)
try:
  fcntl.ioctl(fd, 0xBFAD, int(sys.argv[1]))
finally:
  os.close(fd)
PY
}

# Power the controller on, wake it, and wait until it answers before btattach takes the port.
BRING_UP_PY=$(cat <<'PY'
import fcntl
import os
import select
import struct
import subprocess
import sys
import termios
import time

UART = "/dev/ttyHS1"
BTATTACH = ["/usr/bin/btattach", "-B", UART, "-P", "qca", "-S", "115200"]
VERSION_REQUEST = bytes([0x01, 0x00, 0xFC, 0x01, 0x19])  # EDL patch version request
SET_3MBAUD = bytes([0x01, 0x48, 0xFC, 0x01, 0x0E])  # HCI 0xFC48, QCA_BAUDRATE_3000000
SETTLE_S = (0.0, 0.25, 0.75, 1.5)  # wait before each try
ANSWER_TIMEOUT_S = 0.3


def power(on):
  fd = os.open("/dev/btpower", os.O_RDWR)
  try:
    fcntl.ioctl(fd, 0xBFAD, int(on))
  finally:
    os.close(fd)


def configure(fd, speed):
  attrs = termios.tcgetattr(fd)
  attrs[0] = 0
  attrs[1] = 0
  attrs[2] = (attrs[2] & ~(termios.CSIZE | termios.PARENB | termios.CSTOPB | termios.CRTSCTS)) | termios.CS8 | termios.CREAD | termios.CLOCAL
  attrs[3] = 0
  attrs[4] = speed
  attrs[5] = speed
  attrs[6][termios.VMIN] = 0
  attrs[6][termios.VTIME] = 1
  termios.tcsetattr(fd, termios.TCSANOW, attrs)


def rts(fd, on):
  fcntl.ioctl(fd, termios.TIOCMBIS if on else termios.TIOCMBIC, struct.pack("I", termios.TIOCM_RTS))


def send(fd, speed, value):
  configure(fd, speed)
  rts(fd, False)
  os.write(fd, bytes([value]))
  termios.tcdrain(fd)
  rts(fd, True)


def pulse(fd):
  # WCN3990 power pulses on one open port: off at 2400 baud, then on at 115200.
  send(fd, termios.B2400, 0xC0)
  time.sleep(0.001)
  send(fd, termios.B115200, 0xFC)
  time.sleep(0.1)


def answer(fd):
  """Ask for the patch version; return the vendor event or None."""
  rts(fd, True)
  termios.tcflush(fd, termios.TCIOFLUSH)
  os.write(fd, VERSION_REQUEST)
  termios.tcdrain(fd)
  received = b""
  deadline = time.monotonic() + ANSWER_TIMEOUT_S
  while (remaining := deadline - time.monotonic()) > 0:
    if select.select([fd], [], [], remaining)[0]:
      received += os.read(fd, 256)
    start = received.find(b"\x04\xff")
    if start >= 0 and len(received) >= start + 3 and len(received) >= start + 3 + received[start + 2]:
      return received[start:start + 3 + received[start + 2]]
  return None


def to_3mbaud(fd):
  """Switch the controller to 3 Mbaud and confirm it answers there."""
  for _ in range(3):
    configure(fd, termios.B115200)
    rts(fd, False)
    termios.tcflush(fd, termios.TCIOFLUSH)
    os.write(fd, SET_3MBAUD)
    termios.tcdrain(fd)
    time.sleep(0.01)
    configure(fd, termios.B3000000)
    rts(fd, True)
    time.sleep(0.05)
    if answer(fd) is not None:
      return True
  return False


def main(start):
  power(1)
  powered = time.monotonic()
  held = None
  for attempt, settle in enumerate(SETTLE_S, 1):
    time.sleep(settle)
    fd = os.open(UART, os.O_RDWR | os.O_NOCTTY)
    event = None
    try:
      pulse(fd)
      try:
        event = answer(fd)
        if start and event is not None:
          if to_3mbaud(fd):
            print("bluetooth-radio: controller switched to 3 Mbaud ahead of btattach", flush=True)
          else:
            pulse(fd)  # back to 115200
            event = answer(fd)
            print("bluetooth-radio: could not confirm 3 Mbaud; left at 115200 for btattach", flush=True)
      except OSError as error:  # a failed check must not fail the unit
        print(f"bluetooth-radio: try {attempt} could not ask the controller: {error}", flush=True)
    finally:
      try:
        termios.tcflush(fd, termios.TCIOFLUSH)  # nothing stale left for btattach
      except OSError:
        pass
      if start and event is not None:
        held = fd
      else:
        os.close(fd)
    if event is not None:
      print(f"bluetooth-radio: controller answered on try {attempt}, {time.monotonic() - powered:.2f} s after power on: {event.hex()}", flush=True)
      break
  else:
    print(f"bluetooth-radio: no answer after {len(SETTLE_S)} tries; leaving it to btattach", flush=True)
  if start:
    subprocess.run(["rfkill", "unblock", "bluetooth"], check=True)
    if held is not None:
      # Keep the port open into btattach (each close takes 0.5 s).
      os.set_inheritable(held, True)
    os.execv(BTATTACH[0], BTATTACH)


main(sys.argv[1:] == ["start"])
PY
)

bring_up() {
  /usr/bin/python3 -c "$BRING_UP_PY"
}

setup() {
  model="$(tr -d '\0' </sys/firmware/devicetree/base/model)"
  [[ "$model" == *tici* || "$model" == *tizi* || "$model" == *mici* ]]

  slot="$(sed -n 's/.*androidboot.slot_suffix=\([^ ]*\).*/\1/p' /proc/cmdline)"
  device="/dev/disk/by-partlabel/bluetooth${slot}"
  [[ -b "$device" ]]

  mkdir -p "$FIRMWARE_MOUNT" "$FIRMWARE_BIND" "$BLUETOOTH_STATE" "$BLUETOOTH_BIND"
  chmod 700 "$BLUETOOTH_STATE"
  mountpoint -q "$BLUETOOTH_BIND" || mount --bind "$BLUETOOTH_STATE" "$BLUETOOTH_BIND"
  # Queue bluetoothd early, in the background, so a busy systemd can't stall bring-up.
  systemctl --no-block start bluetooth.service >/dev/null 2>&1 &
  mountpoint -q "$FIRMWARE_MOUNT" || mount -o ro,nosuid,nodev,noexec "$device" "$FIRMWARE_MOUNT"
  mountpoint -q "$FIRMWARE_BIND" || mount --bind "$FIRMWARE_MOUNT/image" "$FIRMWARE_BIND"
  mount -o remount,bind,ro,nosuid,nodev,noexec "$FIRMWARE_BIND"
  # The first bring-up after boot starts from off; later ones keep the drain wait.
  if [[ -e "$STATE_DIR/brought-up" ]]; then
    power 0 || true
    sleep 2
  fi
  mkdir -p "$STATE_DIR"
  touch "$STATE_DIR/brought-up"
}

prepare() {
  setup
  bring_up
  rfkill unblock bluetooth
}

ready() {
  for _ in $(seq 1 200); do
    [[ -e /sys/class/bluetooth/hci0 ]] && break
    sleep 0.1
  done
  [[ -e /sys/class/bluetooth/hci0 ]]

  # Usually already running; start it only if not.
  busctl --system status org.bluez >/dev/null 2>&1 || systemctl start bluetooth.service
  for _ in $(seq 1 100); do
    busctl --system status org.bluez >/dev/null 2>&1 && break
    sleep 0.1
  done
  for _ in $(seq 1 20); do
    bluetoothctl power on >/dev/null 2>&1 && break
    sleep 0.25
  done
  info="$(hciconfig -a hci0)"
  grep -q "UP RUNNING" <<<"$info"
  grep -q "BD Address:" <<<"$info"
  ! grep -q "BD Address: 00:00:00:00:00:00" <<<"$info"

  systemctl start bluealsa.service
}

stop() {
  systemctl stop bluealsa.service bluetooth.service || true
}

cleanup() {
  rfkill block bluetooth || true
  power 0 || true
  mountpoint -q "$BLUETOOTH_BIND" && umount "$BLUETOOTH_BIND" || true
  mountpoint -q "$FIRMWARE_BIND" && umount "$FIRMWARE_BIND" || true
  mountpoint -q "$FIRMWARE_MOUNT" && umount "$FIRMWARE_MOUNT" || true
}

case "${1:-}" in
  prepare) prepare ;;
  # prepare and btattach in one process, so a systemd reload can't stall bring-up.
  start)
    setup
    exec /usr/bin/python3 -c "$BRING_UP_PY" start
    ;;
  ready) ready ;;
  stop) stop ;;
  cleanup) cleanup ;;
  *) exit 2 ;;
esac
