[Unit]
Description=StarPilot Bluetooth radio
After=local-fs.target dbus.service
ConditionPathExists=/sys/firmware/devicetree/base/model

[Service]
Type=simple
ExecCondition=/usr/comma/bluetooth-enabled
ExecStart=/usr/comma/bluetooth-radio start
ExecStartPost=/usr/comma/bluetooth-radio ready
ExecStop=/usr/comma/bluetooth-radio stop
ExecStopPost=/usr/comma/bluetooth-radio cleanup
Restart=on-failure
RestartSec=2
TimeoutStartSec=60
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
